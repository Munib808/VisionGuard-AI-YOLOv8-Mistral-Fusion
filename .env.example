# Copy this file to ".env" and fill in your real API key.
# Never commit your actual .env file to version control.

# Required: your Mistral AI API key from https://console.mistral.ai/
MISTRAL_API_KEY=VVXH4Q3g0JcHltfE5xIqVjUnCf9S7JPf

# Optional overrides (defaults shown):
MISTRAL_MODEL=mistral-small-latest

# YOLO / detection accuracy
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45
YOLO_IMG_SIZE=640

# Comma-separated COCO class names to detect/report (e.g. "person,car,dog").
# Leave EMPTY (the default) to detect ALL 80 COCO classes -- person detections
# and every other object class are then split into two separate reports/PDFs.
TARGET_CLASSES=person

# Tracking gives every person a stable ID across frames so counts are accurate
ENABLE_TRACKING=true
TRACKER_CONFIG=bytetrack.yaml

# Video source
WEBCAM_INDEX=0
#VIDEO_SOURCE_MODE=file
#FALLBACK_VIDEO_PATH=noperson.mp4
WINDOW_SECONDS=3.0
WINDOW_MAX_FRAMES=300
SHOW_VIDEO_WINDOW=true

# Background report worker (prevents the video window from freezing during
# Mistral API calls / DB writes)
REPORT_QUEUE_MAX_SIZE=5

# PDF export (see `python view_reports.py pdf --help`)
REPORTS_PDF_DIR=reports_pdf
EXPORT_PDF_ON_EXIT=false
